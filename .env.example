# Copy to .env and adjust. All keys are prefixed FLEET_.

# Where status.json + history.jsonl land (inside the vault).
NEXUS_VAULT_ROOT=$HOME/Vaults/loupe-vault
NEXUS_STATUS_DIR=ops/dashboard

# Where the relay's from-{seat}/{runs,transcripts,recon} lanes live. Heartbeats
# stay on NEXUS_VAULT_ROOT above — this is relay-run state only, moved off
# loupe-vault when the Tower audit repointed active relay state 2026-07-10.
NEXUS_RELAY_ROOT=$HOME/Vaults/homelab-vault

# Sweep cadence.
NEXUS_HEARTBEAT_INTERVAL_SECONDS=300

# Disk thresholds (percent used).
NEXUS_DISK_WARN_PCT=80
NEXUS_DISK_CRIT_PCT=90

# Backup staleness (hours since the marker was last touched).
NEXUS_BACKUP_STALE_WARN_HOURS=36
NEXUS_BACKUP_STALE_CRIT_HOURS=72

# Off-box dead-man's switch. The poller GETs this on every run; if worker2 or the
# poller dies the pings stop and the external service alerts you. A hard fleet
# crit hits <url>/fail. Leave blank to disable.
# Example (healthchecks.io): https://hc-ping.com/<uuid>
NEXUS_HEARTBEAT_PING_URL=

# Bind. MCP already owns 8765 on worker2; keep this separate.
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8770

# Storage host probed for the NAS path check. RFC 5737 documentation address by default.
NEXUS_NAS_PROBE_TARGET=192.0.2.10

# Web Push contact address (RFC 2606 example domain by default).
NEXUS_VAPID_SUB=mailto:admin@example.com

# Loopback plus this host tailnet address. Never 0.0.0.0.
NEXUS_BIND_ADDRESSES=127.0.0.1,100.64.0.10
